# f-b-v – Grundeinstellungen

DirectoryIndex index.php
Options -Indexes

# Web-App-Manifest: Apache kennt die Endung nicht von sich aus
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Der Service Worker darf nicht zwischengespeichert werden, sonst bleiben
# Änderungen an den Benachrichtigungen wirkungslos.
<FilesMatch "^sw\.js$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

# Suchmaschinen fernhalten (interner Bereich)
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"

    # PHP-Version und Hosting-Panel nicht ausplaudern. Zweimal, weil Apache
    # erfolgreiche Antworten und Fehlerantworten getrennt behandelt. Über
    # .user.ini geht das nicht: expose_php ist PHP_INI_SYSTEM.
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # HSTS – der Browser wechselt von sich aus auf https, ohne je unverschlüsselt
    # zu fragen. Ohne das bleibt die allererste Anfrage abfangbar.
    # Vorerst kurz gehalten; nach erfolgreicher Prüfung auf 31536000 (ein Jahr)
    # hochsetzen. Nur über HTTPS senden, so will es RFC 6797.
    Header always set Strict-Transport-Security "max-age=300" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"

    # Zweite Verteidigungslinie gegen XSS. Alles kommt von der eigenen Herkunft;
    # blob: braucht das Verkleinern im Browser (scaleFile() in assets/app.js).
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' blob:; script-src 'self'; style-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'"
</IfModule>

# Upload-Limits, falls PHP als Apache-Modul läuft.
# Bei FastCGI/FPM – dem Normalfall unter Plesk – gilt stattdessen .user.ini.
<IfModule mod_php.c>
    php_value upload_max_filesize 25M
    php_value post_max_size 150M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 25M
    php_value post_max_size 150M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Sollte je ein .git-Verzeichnis im Dokumentenstamm landen – etwa weil eine
# Bereitstellung dorthin auscheckt –, wäre der komplette Quellcode samt
# Verlauf abrufbar. Das hier verhindert es.
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
</IfModule>

# Datenablagen und Programmcode nicht direkt ausliefern
<FilesMatch "\.(json|md|log|ini|gitignore|gitattributes)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# HTTPS erzwingen – erst aktivieren, wenn ein Zertifikat eingerichtet ist
<IfModule mod_rewrite.c>
     RewriteEngine On
     RewriteCond %{HTTPS} !=on
     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
 </IfModule>
